# Nearvora environment template. Copy to `.env` and fill in only what you need.
# The app runs entirely in demo mode with no credentials.

NODE_ENV=development

# Demo safety. Set DEMO_MODE=false only after live provider work is complete.
DEMO_MODE=true
DATA_MODE=demo

# Required in production (minimum 24 characters). Demo mode has a development fallback.
SESSION_SECRET=replace-with-at-least-24-random-characters

# PostgreSQL used by the Prisma schema, migrations and seed.
DATABASE_URL=postgresql://nearvora:nearvora@localhost:5432/nearvora?schema=public

# Optional OpenAI-compatible model. Without these, the labelled deterministic planner is used.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# NEAR Intents / OutLayer integration boundaries. Live execution remains disabled.
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_ACCOUNT_ID=
NEAR_INTENTS_API_URL=
OUTLAYER_API_URL=
OUTLAYER_API_KEY=

# Naira payment provider (demo, monnify, paystack or flutterwave).
PAYMENT_PROVIDER=demo
PAYMENT_WEBHOOK_SECRET=

# Formance ledger adapter.
FORMANCE_LEDGER_URL=
FORMANCE_LEDGER_TOKEN=
