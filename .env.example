# Nearvora environment template. Copy to `.env` and fill in only what you need.
# The app runs entirely in demo mode with no provider credentials.

NODE_ENV=development

# Demo safety. LIVE mode is not available in this build and fails closed.
DEMO_MODE=true
DATA_MODE=demo

# Required in production (minimum 24 characters). Demo mode has a development fallback.
SESSION_SECRET=replace-with-at-least-24-random-characters

# PostgreSQL used by the Prisma schema, migrations and seed.
# Runtime services are still in-memory; see README "Database".
DATABASE_URL=postgresql://nearvora:nearvora@localhost:5432/nearvora?schema=public

# AI provider (server-side only): near-ai-cloud or groq.
# Never expose credentials in client code or NEXT_PUBLIC_* variables.
# Do not reuse keys belonging to other providers, MCP servers or tools.
AI_PROVIDER=near-ai-cloud

# NEAR AI Cloud (used when AI_PROVIDER=near-ai-cloud).
# Example: deepseek-ai/DeepSeek-V4.1-Flash-1017.
NEAR_AI_KEY=
NEAR_AI_MODEL=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_INPUT_COST_PER_MILLION=
NEAR_AI_OUTPUT_COST_PER_MILLION=

# Groq (used when AI_PROVIDER=groq).
# Example: openai/gpt-oss-120b (tools, structured outputs, JSON mode, reasoning).
GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_INPUT_COST_PER_MILLION=
GROQ_OUTPUT_COST_PER_MILLION=

# Common guardrails (defaults shown). Output limits account for reasoning models.
AI_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=4096
AI_MAX_STEPS=4
AI_DAILY_REQUEST_LIMIT=200
AI_DAILY_TOKEN_LIMIT=200000
# Optional fallback pricing if provider-specific values are blank.
AI_INPUT_COST_PER_MILLION=
AI_OUTPUT_COST_PER_MILLION=

# NEAR Intents / OutLayer integration boundaries. Live execution remains disabled.
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_ACCOUNT_ID=
# Official 1Click Swap API. Leave blank to use https://1click.chaindefuser.com/v0.
NEAR_INTENTS_API_URL=
# Partner JWT from https://partners.near-intents.org (sent as X-API-Key).
# Authenticated requests use the partner fee schedule instead of the +0.25% fee.
# Keep this server-side only; never expose it as NEXT_PUBLIC_*.
NEAR_INTENTS_API_KEY=
# Set only if you intentionally accept the unauthenticated 1Click fee schedule.
NEAR_INTENTS_ALLOW_UNAUTHENTICATED=false
NEAR_INTENTS_TIMEOUT_MS=20000
NEAR_INTENTS_SLIPPAGE_BPS=100
# Optional 1Click distribution/referral identifier.
NEAR_INTENTS_REFERRAL=
# Default recipient and refund account for INTENTS/NEAR-account quotes.
NEAR_INTENTS_RECIPIENT=
NEAR_INTENTS_REFUND_TO=
# Optional assetId overrides, comma-separated: USDT=nep141:...,BTC=nep141:...
NEAR_INTENTS_ASSET_MAP=
OUTLAYER_API_URL=
OUTLAYER_API_KEY=

# Naira payment provider. Bank deposits, payouts and bill payments are sandbox
# only. No durable provider ledger or production authentication is implemented.
PAYMENT_PROVIDER=demo
PAYMENT_WEBHOOK_SECRET=
# Optional isolated Flutterwave sandbox API. Use a test key only; the server
# client rejects FLWSECK_LIVE keys. Never prefix these with NEXT_PUBLIC_.
FLUTTERWAVE_TEST_SECRET_KEY=

# Formance ledger adapter.
FORMANCE_LEDGER_URL=
FORMANCE_LEDGER_TOKEN=
